# Voice Interaction API Environment Variables

# Picovoice Access Key (required for TTS)
# Get your key from: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# Whisper Model Configuration
# Download models from: https://huggingface.co/ggerganov/whisper.cpp
# Place model files in ./models/ directory
WHISPER_MODEL_PATH=/app/models/ggml-base.en.bin

# API Configuration
API_TIMEOUT=30

# Frontend Configuration (if running separately)
REACT_APP_API_URL=http://localhost:8000
